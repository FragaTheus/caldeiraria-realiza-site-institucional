# Para rodar o projeto (Docker ou Gradle), preencha as variáveis abaixo.
#
# MAIL_USERNAME  → e-mail de origem (pertencente ao servidor SMTP configurado)
# MAIL_APP_PASSWORD → senha de app do e-mail de origem (não a senha normal)
# MAIL_TO        → e-mail de destino que receberá as mensagens do formulário
# ---------------------------------------------------------------------------------

MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_TO=

